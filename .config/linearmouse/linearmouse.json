{
  "$schema" : "https:\/\/schema.linearmouse.app\/0.10.4",
  "schemes" : [
    {
      "buttons" : {
        "mappings" : [
          {
            "action" : "missionControl",
            "button" : 4,
            "command" : false,
            "control" : false,
            "option" : false,
            "shift" : false
          }
        ]
      },
      "if" : {
        "device" : {
          "category" : "mouse",
          "productID" : "0xc547",
          "productName" : "USB Receiver",
          "vendorID" : "0x46d"
        }
      },
      "pointer" : {
        "acceleration" : 0.25,
        "disableAcceleration" : true
      },
      "scrolling" : {
        "acceleration" : {
          "vertical" : 1
        },
        "distance" : {
          "vertical" : 2
        },
        "reverse" : {
          "vertical" : true
        },
        "speed" : {
          "vertical" : 0
        }
      }
    }
  ]
}