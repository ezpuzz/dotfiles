[user]
	name = Emory Petermann
	email = emory@onlyfor.us
[core]
	preloadindex = true
	fscache = true
	autocrlf = false
	ignorecase = false
[commit]
	cleanup = strip
[push]
	default = current
	autoSetupRemote = true
[alias]
	lg = log --graph --abbrev-commit --decorate --date=short --format=format:\"%C(bold blue)%h%C(reset) %C(bold green)%ad%C(reset) %C(white)%<(50,trunc)%s%C(reset)%n%C(dim white)%an%C(reset)%C(auto)%d%C(reset)%n\"
[pull]
	rebase = true
[color "diff"]
	whitespace = red reverse
[rerere]
	enabled = true
[rebase]
	autostash = true
[fetch]
	recurseSubmodules = true
[gc]
	auto = 256
[winUpdater]
	recentlySeenVersion = 2.24.1.windows.2
[gui]
	recentrepo = E:/repos/capbase
